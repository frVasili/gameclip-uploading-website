# Copy to .env and fill in. Everything except ADMIN_PASSWORD has a sensible default.

# Your admin password (or ADMIN_PASSWORD_FILE=/run/secrets/admin_password). If neither is set, one is
# generated on first start and written to admin-password.txt in the data volume.
ADMIN_PASSWORD=

# The address people use to reach the site, for links and Discord embeds. Leave empty to work it out
# from each request (fine behind most reverse proxies).
PUBLIC_URL=https://clips.example.com

# Name shown on the site and in Discord embeds.
SITE_NAME=Clips

# Who tells us the visitor's real IP (used to rate-limit wrong passwords):
#   cloudflare = behind Cloudflare / a Cloudflare Tunnel, proxy = behind another reverse proxy, none = direct
TRUST_PROXY=none

# Limits
MAX_UPLOAD_GB=20          # largest single recording
DEFAULT_QUOTA_GB=20       # storage per friend (recordings + clips); you can change it per person
MIN_FREE_GB=10            # refuse uploads that would leave less free disk than this
SOURCE_RETENTION_DAYS=0   # delete uploaded recordings after this many days (clips stay). 0 = keep forever
MAX_JOBS_PER_USER=3       # exports one friend can have waiting at once

# Encoding (CPU): runs at low priority so the machine stays usable
ENCODE_THREADS=4
ENCODE_NICE=15
# Optional GPU encoding (AMD/Intel, VAAPI). Also pass the device to the container (see compose.yml).
VAAPI_DEVICE=
# Tick "Fast GPU encode" by default for new edits (only if the GPU works). People can still untick it per export.
GPU_DEFAULT=false
# With a GPU: how it helps convert uploads not every browser can play (e.g. HEVC) for the editor preview. This runs in
# the background after an upload; browsers that can play the recording itself don't wait for it.
# full = GPU decodes and encodes (default) · decode = GPU decodes, CPU encodes · off = CPU only.
# Measured on an RX 580 (60 s of 1080p60 HEVC): full 19 s, off 21 s (but the CPU stays busy), decode 36 s.
PREVIEW_HW=full

# Largest "Discord" size preset in MB. Tested 2026-11: Discord embedded files up to ~273 MB.
EMBED_CAP_MB=250
